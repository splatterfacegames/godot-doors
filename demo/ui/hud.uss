:root {
  --ink: #f3ead8;
  --dim: #b8ab93;
  --paper: rgba(14, 12, 18, 0.78);
  --accent: #d9a35b;
  --danger: #d9534f;
}
.root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.panel {
  position: absolute;
  background-color: var(--paper);
  border-radius: 6px;
  padding: 10px 14px;
  border-width: 1px;
  border-color: rgba(217, 163, 91, 0.35);
}
.status { left: 16px; top: 16px; width: 300px; }
.suspicion { right: 16px; top: 16px; width: 260px; }
.log { right: 16px; top: 112px; width: 420px; }
.head { font-size: 11px; color: var(--accent); -unity-font-style: bold; letter-spacing: 2px; margin-top: 6px; margin-bottom: 2px; }
.clock { font-size: 26px; color: var(--ink); -unity-font-style: bold; }
.place { font-size: 13px; color: var(--dim); }
.obj { font-size: 13px; color: var(--ink); white-space: normal; margin-top: 2px; }
.obj.done { color: #8fbf7f; }
.obj.secret { color: var(--accent); }
.track { height: 10px; background-color: rgba(255, 255, 255, 0.12); border-radius: 5px; margin-top: 4px; }
.fill { height: 10px; width: 0%; background-color: var(--accent); border-radius: 5px; }
.fill.hot { background-color: var(--danger); }
.admission { font-size: 12px; color: var(--dim); margin-top: 6px; }
.line { font-size: 13px; color: var(--ink); white-space: normal; margin-top: 3px; }
.line.muffled { color: var(--dim); -unity-font-style: italic; }
.line.clue { color: var(--accent); }
.toast {
  position: absolute; top: 18px; left: 340px; right: 300px;
  -unity-text-align: middle-center; font-size: 17px; color: var(--ink);
  opacity: 0; transition-property: opacity; transition-duration: 0.25s;
}
.toast.show { opacity: 1; }
.bottom { position: absolute; left: 0; right: 0; bottom: 24px; align-items: center; }
.prompt {
  font-size: 15px; color: var(--ink); background-color: var(--paper);
  padding: 8px 16px; border-radius: 6px;
}
.chore-track { width: 240px; height: 8px; background-color: rgba(255, 255, 255, 0.15); border-radius: 4px; margin-bottom: 8px; }
.chore-fill { height: 8px; width: 0%; background-color: #8fbf7f; border-radius: 4px; }
.hidden { display: none; }
.overlay {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background-color: rgba(6, 5, 10, 0.72);
  align-items: center; justify-content: center;
}
.card {
  width: 560px; padding: 28px 32px; background-color: rgba(20, 17, 24, 0.96);
  border-width: 1px; border-color: rgba(217, 163, 91, 0.5); border-radius: 8px;
}
.kicker { font-size: 12px; color: var(--accent); letter-spacing: 2px; }
.title { font-size: 38px; color: var(--ink); -unity-font-style: bold; margin-top: 4px; }
.title.small { font-size: 26px; }
.subtitle { font-size: 15px; color: var(--dim); margin-bottom: 14px; }
.blurb { font-size: 14px; color: var(--ink); white-space: normal; margin-bottom: 18px; }
.keys { font-size: 14px; color: var(--ink); white-space: normal; margin-top: 10px; margin-bottom: 14px; }
.btn {
  height: 38px; margin-top: 8px; font-size: 15px; color: var(--ink);
  background-color: rgba(255, 255, 255, 0.08); border-radius: 5px; border-width: 1px;
  border-color: rgba(217, 163, 91, 0.4);
}
.btn:hover { background-color: rgba(217, 163, 91, 0.25); }
.btn.primary { background-color: rgba(217, 163, 91, 0.35); }
.btn.primary:hover { background-color: rgba(217, 163, 91, 0.55); }
