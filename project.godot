; Engine configuration file.
config_version=5

[application]

config/name="godot-doors"
config/description="Rooms and doors for Godot 4: access, hearing, sight, knocking, discovery and residency. Demo: Ashcombe House."
run/main_scene="res://demo/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

RoomsAndDoors="*res://addons/rooms_and_doors/rooms_and_doors.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/typesetter/plugin.cfg", "res://addons/godot_uxml/plugin.cfg")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2

[rooms_and_doors]

debug/overlay=false
content/fade_to_black=false
